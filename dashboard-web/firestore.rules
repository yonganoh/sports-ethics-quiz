rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // members/<이메일(소문자)> 문서의 role 필드: "admin" | "editor" | "viewer"
    function myRole() {
      return request.auth != null && request.auth.token.email != null
        && exists(/databases/$(database)/documents/members/$(request.auth.token.email.lower()))
        ? get(/databases/$(database)/documents/members/$(request.auth.token.email.lower())).data.role
        : null;
    }
    function isMember() { return myRole() in ['admin', 'editor', 'viewer']; }
    function canWrite() { return myRole() in ['admin', 'editor']; }
    function isAdmin()  { return myRole() == 'admin'; }

    // 멤버 명단: 본인 문서는 읽기, 관리는 관리자만
    match /members/{email} {
      allow read: if request.auth != null && request.auth.token.email.lower() == email || isAdmin();
      allow write: if isAdmin();
    }

    // 연락처: 관리자만
    match /contacts/{id} {
      allow read, write: if isAdmin();
    }

    // 개인 공간: 본인만
    match /data/users/{uid}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 팀 공유 데이터: 멤버는 읽기, 편집자 이상은 쓰기
    match /{col}/{id} {
      allow read:  if col in ['projects','tasks','settings','milestones','modules','issues','ecm','partners','todos','meetings','refs','calcs','days'] && isMember();
      allow write: if col in ['projects','tasks','settings','milestones','modules','issues','ecm','partners','todos','meetings','refs','calcs','days'] && canWrite();
    }
  }
}
